;===============================================================================
; PT3 engine — Bulba-compatible decode/output (clean-room).
; Format reference: docs/PT3FormatSpec.md. Output via PSG_WRITE_ROUTED.

#DEFINE PT3_SPEED_OFF   100
#DEFINE PT3_PATTAB_OFF  103
#DEFINE PT3_POS_OFF     192
#DEFINE PT3_CH_SIZE     29

#DEFINE PT3C_PSINOR     0
#DEFINE PT3C_PSINSM     1
#DEFINE PT3C_CRTNSL     6
#DEFINE PT3C_TNACC      8
#DEFINE PT3C_ORNPTR     13
#DEFINE PT3C_SAMPTR     15
#DEFINE PT3C_NNTSKP     17
#DEFINE PT3C_NOTE       18
#DEFINE PT3C_ENV_EN     20
#DEFINE PT3C_FLAGS      21
#DEFINE PT3C_NTSKCN     27
#DEFINE PT3C_VOLUME     28

#DEFINE PT3_OFF_SAM_TAB 105
#DEFINE PT3_OFF_ORN_TAB 169

#DEFINE PT3AY_TONA      0
#DEFINE PT3AY_TONB      2
#DEFINE PT3AY_TONC      4
#DEFINE PT3AY_MIXER     7
#DEFINE PT3AY_AMPA      8
#DEFINE PT3AY_AMPB      9
#DEFINE PT3AY_AMPC      10
#DEFINE PT3AY_ENVTP     13

#include "pt3notetables.inc"
#include "pt3chregs.inc"

; Zero B bytes at HL.
PT3_MEM_CLR:
	PUSH	AF
PT3_MEM_CLR_LOOP:
	XOR	A
	LD	(HL), A
	INC	HL
	DJNZ	PT3_MEM_CLR_LOOP
	POP	AF
	RET

; A = note 1..96 -> HL = period from PT3_NT_. A=0 -> HL=0.
PT3_NOTE_TO_PERIOD:
	OR	A
	RET	Z
	PUSH	DE
	DEC	A
	LD	L, A
	LD	H, 0
	ADD	HL, HL
	LD	DE, PT3_NT_
	ADD	HL, DE
	LD	E, (HL)
	INC	HL
	LD	D, (HL)
	EX	DE, HL
	POP	DE
	RET

; Copy selected Bulba note table into PT3_NT_ (192 bytes).
; A = (tone_table << 1) & 7 from header byte 99.
PT3_SELECT_NOTE_TABLE:
	AND	7
	LD	L, A
	LD	H, 0
	ADD	HL, HL
	ADD	HL, HL
	ADD	HL, HL
	ADD	HL, HL
	ADD	HL, HL
	ADD	HL, HL
	ADD	HL, HL
	LD	DE, PT3_NT_TABLES
	ADD	HL, DE
	LD	DE, PT3_NT_
	LD	BC, 192
	LDIR
	RET

; Zero PT3_VT_ (0 = loudest on AY, matches Bulba INITV baseline).
PT3_INIT_VOL_TABLE:
	LD	HL, PT3_VT_
	LD	B, 16
	XOR	A
PT3_INIT_VT_LOOP:
	LD	(HL), A
	INC	HL
	DJNZ	PT3_INIT_VT_LOOP
	RET

; BC = stream pointer. Carry set if BC >= MUSIC_BUF + MUSIC_SIZE.
PT3_BC_IN_RANGE:
	LD	HL, MUSIC_BUF
	LD	DE, (MUSIC_SIZE)
	ADD	HL, DE
	OR	A
	SBC	HL, BC
	RET

; DE = absolute stream offset from module base; returns HL = safe pointer.
PT3_ABS_OFF_TO_PTR:
	LD	HL, (MUSIC_SIZE)
	OR	A
	SBC	HL, DE
	JR	NC, PT3_ABS_PTR_OK
	LD	HL, (PT3_MDL_PTR)
	RET
PT3_ABS_PTR_OK:
	LD	HL, (PT3_MDL_PTR)
	ADD	HL, DE
	RET

; DE = offset from module base. C if DE >= MUSIC_SIZE (invalid).
PT3_OFFSET_IN_RANGE:
	LD	HL, (MUSIC_SIZE)
	LD	A, H
	OR	L
	RET	Z
	LD	A, D
	CP	H
	JR	C, PT3_OFF_OOR
	JR	NZ, PT3_OFF_OK
	LD	A, E
	CP	L
	RET	NC
PT3_OFF_OOR:
	SCF
	RET
PT3_OFF_OK:
	OR	A
	RET

; Load pattern at current position pointer; $FF ends song.
; Returns C if pattern table entry out of range.
PT3_BIND_PATTERN:
	LD	HL, (PT3_POS_PTR)
	LD	B, H
	LD	C, L
	CALL	PT3_BC_IN_RANGE
	JR	NC, PT3_BIND_POS_OK
	LD	HL, (PT3_MDL_PTR)
	LD	DE, PT3_POS_OFF
	ADD	HL, DE
	LD	(PT3_POS_PTR), HL
PT3_BIND_POS_OK:
	LD	A, (HL)
	CP	$FF
	JP	Z, PT3_BIND_FF
	CP	128
	JR	C, PT3_BIND_POS_VALID
	XOR	A
PT3_BIND_POS_VALID:
	PUSH	AF
	ADD	A, A			; tune.com: table[P*2], [P*2+1], [P*2+2] -> stream A,B,C
	LD	E, A
	LD	D, 0
	LD	HL, (PT3_PATS_PTR)
	ADD	HL, DE
	LD	E, (HL)
	INC	HL
	LD	D, (HL)
	CALL	PT3_OFFSET_IN_RANGE
	JR	NC, PT3_BIND_CHA_OK
	JR	PT3_BIND_FAIL
PT3_BIND_CHA_OK:
	CALL	PT3_ABS_OFF_TO_PTR
	LD	(PT3_ADR_A), HL
	LD	E, (HL)
	INC	HL
	LD	D, (HL)
	CALL	PT3_OFFSET_IN_RANGE
	JR	NC, PT3_BIND_CHB_OK
	JR	PT3_BIND_FAIL
PT3_BIND_CHB_OK:
	CALL	PT3_ABS_OFF_TO_PTR
	LD	(PT3_ADR_B), HL
	LD	E, (HL)
	INC	HL
	LD	D, (HL)
	CALL	PT3_OFFSET_IN_RANGE
	JR	NC, PT3_BIND_CHC_OK
	JR	PT3_BIND_FAIL
PT3_BIND_CHC_OK:
	CALL	PT3_ABS_OFF_TO_PTR
	LD	(PT3_ADR_C), HL
	POP	AF
	LD	IX, PT3_CHA
	LD	A, (IX + PT3C_NNTSKP)
	LD	(IX + PT3C_NTSKCN), A
	LD	IX, PT3_CHB
	LD	A, (IX + PT3C_NNTSKP)
	LD	(IX + PT3C_NTSKCN), A
	LD	IX, PT3_CHC
	LD	A, (IX + PT3C_NNTSKP)
	LD	(IX + PT3C_NTSKCN), A
	OR	A
	RET

PT3_BIND_FAIL:
	POP	AF
	SCF
	RET

PT3_BIND_FF:
	POP	AF
	JP	PT3_END_SONG

; Advance order list and bind next pattern (after channel A line ends).
PT3_ADVANCE_POSITION:
	LD	HL, (PT3_POS_PTR)
	INC	HL
	LD	(PT3_POS_PTR), HL
	JP	PT3_BIND_PATTERN

PT3_END_SONG:
	; Do not ROUT-mute here (causes whine/pop); START_EXIT mutes once if PSG_TOUCHED.
	LD	A, PLAY_STOPPED
	LD	(PLAY_STATE), A
	RET

; IX = channel; BC = stream ptr. Returns BC past line terminator.
PT3_DECODE_CH:
	; Bulba PT3PD preamble (save portamento state)
	LD	A, (IX + PT3C_NOTE)
	LD	(PT3_PRNOTE), A
	LD	A, (IX + PT3C_CRTNSL)
	LD	(PT3_PRSLIDE), A
	LD	A, (IX + PT3C_CRTNSL + 1)
	LD	(PT3_PRSLIDE + 1), A
	LD	DE, $2010
PT3_PD_LP2:
	CALL	PT3_BC_IN_RANGE
	JR	C, PT3_PD_FIN
	LD	A, (BC)
	INC	BC
	ADD	A, E
	JR	C, PT3_PD_ORSM
	ADD	A, D
	JR	Z, PT3_PD_FIN
	JR	C, PT3_PD_SAM
	ADD	A, E
	JP	Z, PT3_PD_REL
	JP	C, PT3_PD_VOL
	ADD	A, E
	JR	Z, PT3_PD_EOFF
	JR	C, PT3_PD_SORE
	ADD	A, 96
	JP	C, PT3_PD_NOTE
	ADD	A, E
	JP	C, PT3_PD_ORN
	ADD	A, D
	JR	C, PT3_PD_NOIS
	ADD	A, E
	JR	C, PT3_PD_ESAM
	ADD	A, A
	CP	32
	JR	NC, PT3_PD_LP2
	PUSH	AF
	LD	HL, PT3_SPCCOMS
	POP	AF
	LD	E, A
	LD	D, 0
	ADD	HL, DE
	LD	E, (HL)
	INC	HL
	LD	D, (HL)
	PUSH	BC
	PUSH	IX
	LD	HL, PT3_SPC_RETURN
	PUSH	HL
	EX	DE, HL
	JP	(HL)
PT3_SPC_RETURN:
	POP	IX
	POP	BC
	JP	PT3_PD_LP2

PT3_PD_FIN:
	LD	A, (IX + PT3C_NNTSKP)
	LD	(IX + PT3C_NTSKCN), A
	RET

PT3_PD_ORSM:
	XOR	A
	LD	(IX + PT3C_ENV_EN), A
	CALL	PT3_SETORN
PT3_PD_SAM_:
	CALL	PT3_BC_IN_RANGE
	JR	C, PT3_PD_FIN
	LD	A, (BC)
	INC	BC
	RRCA
	JR	PT3_PD_SAM

PT3_PD_SAM:
	CALL	PT3_SETSAM
	JP	PT3_PD_LP2

PT3_PD_VOL:
	RRCA
	RRCA
	RRCA
	RRCA
	LD	(IX + PT3C_VOLUME), A
	JP	PT3_PD_LP2

PT3_PD_EOFF:
	XOR	A
	LD	(IX + PT3C_ENV_EN), A
	LD	(IX + PT3C_PSINOR), A
	JP	PT3_PD_LP2

PT3_PD_SORE:
	DEC	A
	JR	NZ, PT3_PD_ENV_STUB
	CALL	PT3_BC_IN_RANGE
	JR	C, PT3_PD_FIN
	LD	A, (BC)
	INC	BC
	LD	(IX + PT3C_NNTSKP), A
	JP	PT3_PD_LP2

PT3_PD_ENV_STUB:
	CALL	PT3_SETENV
	JP	PT3_PD_LP2

PT3_PD_ORN:
	CALL	PT3_SETORN
	JP	PT3_PD_LP2

PT3_PD_NOIS:
	LD	(PT3_NS_BASE), A
	JP	PT3_PD_LP2

PT3_PD_ESAM:
	XOR	A
	LD	(IX + PT3C_ENV_EN), A
	LD	(IX + PT3C_PSINOR), A
	CALL	NZ, PT3_SETENV
	JR	PT3_PD_SAM_

PT3_PD_REL:
	RES	0, (IX + PT3C_FLAGS)
	JP	PT3_PD_LP2

PT3_PD_NOTE:
	LD	(IX + PT3C_NOTE), A
	SET	0, (IX + PT3C_FLAGS)
	XOR	A
	LD	(IX + PT3C_CRTNSL), A
	LD	(IX + PT3C_CRTNSL + 1), A
	LD	(IX + PT3C_TSLCNT), A
	LD	(IX + PT3C_TNACC), A
	LD	(IX + PT3C_TNACC + 1), A
	LD	(IX + PT3C_TNDELT), A
	LD	(IX + PT3C_TNDELT + 1), A
	LD	(IX + PT3C_TSLSTP), A
	LD	(IX + PT3C_TSLSTP + 1), A
	LD	(IX + PT3C_SLTONT), A
	JP	PT3_PD_LP2

PT3_SPC_NOP:
	RET
PT3_SPC_GLISS:
	CALL	PT3_BC_SKIP2
	RET
PT3_SPC_PORT:
	CALL	PT3_BC_SKIP5
	RET
PT3_SPC_SMPOS:
	CALL	PT3_BC_SKIP1
	RET
PT3_SPC_ORPOS:
	CALL	PT3_BC_SKIP1
	RET
PT3_SPC_VIBRT:
	CALL	PT3_BC_SKIP2
	RET
PT3_SPC_ENGLS:
	CALL	PT3_BC_SKIP3
	RET

PT3_BC_SKIP1:
	CALL	PT3_BC_IN_RANGE
	RET	C
	INC	BC
	RET
PT3_BC_SKIP2:
	CALL	PT3_BC_SKIP1
	CALL	PT3_BC_SKIP1
	RET
PT3_BC_SKIP3:
	CALL	PT3_BC_SKIP2
	JP	PT3_BC_SKIP1
PT3_BC_SKIP5:
	CALL	PT3_BC_SKIP3
	JP	PT3_BC_SKIP2
PT3_SPC_DELAY:
	CALL	PT3_BC_IN_RANGE
	JR	NC, PT3_SPC_DELAY_RD
	RET
PT3_SPC_DELAY_RD:
	LD	A, (BC)
	INC	BC
	LD	(PT3_DELAY), A
	RET

; Envelope command (PD_ENV path).
PT3_SETENV:
	LD	(IX + PT3C_ENV_EN), $10
	CALL	PT3_BC_IN_RANGE
	RET	C
	LD	A, (BC)
	INC	BC
	LD	(PT3_AY_REGS + PT3AY_ENVTP), A
	CALL	PT3_BC_IN_RANGE
	RET	C
	LD	A, (BC)
	INC	BC
	LD	(PT3_ENVBASE), A
	CALL	PT3_BC_IN_RANGE
	RET	C
	LD	A, (BC)
	INC	BC
	LD	H, A
	LD	A, (PT3_ENVBASE)
	LD	L, A
	LD	(PT3_ENVBASE), HL
	XOR	A
	LD	(IX + PT3C_PSINOR), A
	LD	(PT3_CUREDEL), A
	XOR	A
	LD	(PT3_CURESLD), A
	LD	(PT3_CURESLD + 1), A
	RET

; A = ornament index. IX = channel.
PT3_SETORN:
	ADD	A, A
	LD	E, A
	LD	D, 0
	XOR	A
	LD	(IX + PT3C_PSINOR), A
	LD	HL, (PT3_ORN_PTRS)
	ADD	HL, DE
	LD	E, (HL)
	INC	HL
	LD	D, (HL)
	LD	HL, (PT3_MDL_PTR)
	ADD	HL, DE
	LD	(IX + PT3C_ORNPTR), L
	LD	(IX + PT3C_ORNPTR + 1), H
	RET

; A = sample index. IX = channel.
PT3_SETSAM:
	ADD	A, A
	LD	E, A
	LD	D, 0
	LD	HL, (PT3_SAM_PTRS)
	ADD	HL, DE
	LD	E, (HL)
	INC	HL
	LD	D, (HL)
	LD	HL, (PT3_MDL_PTR)
	ADD	HL, DE
	LD	(IX + PT3C_SAMPTR), L
	LD	(IX + PT3C_SAMPTR + 1), H
	RET

PT3_SPCCOMS:
	.DW	PT3_SPC_NOP
	.DW	PT3_SPC_GLISS
	.DW	PT3_SPC_PORT
	.DW	PT3_SPC_SMPOS
	.DW	PT3_SPC_ORPOS
	.DW	PT3_SPC_VIBRT
	.DW	PT3_SPC_NOP
	.DW	PT3_SPC_NOP
	.DW	PT3_SPC_ENGLS
	.DW	PT3_SPC_DELAY
	.DW	PT3_SPC_NOP
	.DW	PT3_SPC_NOP
	.DW	PT3_SPC_NOP
	.DW	PT3_SPC_NOP
	.DW	PT3_SPC_NOP
	.DW	PT3_SPC_NOP

; IX = channel; HL = prior tone. Returns HL = period; stores amp in PT3_AMPL.
PT3_CHANNEL_TO_SHADOW:
	CALL	PT3_CHREGS
	LD	A, (PT3_AMPL)
	LD	(PT3_AY_REGS + PT3AY_AMPA), A
	LD	(PT3_AY_REGS + PT3AY_TONA), HL
	RET

PT3_CHANNEL_TO_SHADOW_B:
	CALL	PT3_CHREGS
	LD	A, (PT3_AMPL)
	LD	(PT3_AY_REGS + PT3AY_AMPB), A
	LD	(PT3_AY_REGS + PT3AY_TONB), HL
	RET

PT3_CHANNEL_TO_SHADOW_C:
	CALL	PT3_CHREGS
	LD	A, (PT3_AMPL)
	LD	(PT3_AY_REGS + PT3AY_AMPC), A
	LD	(PT3_AY_REGS + PT3AY_TONC), HL
	RET

; IX = channel state. Returns NZ if tone should be enabled for this channel.
PT3_CH_IS_ACTIVE:
	LD	A, (IX + PT3C_NOTE)
	OR	A
	RET	Z
	BIT	0, (IX + PT3C_FLAGS)
	RET

PT3_FLUSH_AY:
	PUSH	BC
	PUSH	DE
	PUSH	HL
	XOR	A
	LD	(PT3_ADDTOEN), A
	LD	(PT3_AY_REGS + PT3AY_MIXER), A
	LD	A, $FF
	LD	(PT3_AY_REGS + PT3AY_ENVTP), A
	LD	IX, PT3_CHA
	LD	HL, (PT3_AY_REGS + PT3AY_TONA)
	CALL	PT3_CHANNEL_TO_SHADOW
	LD	IX, PT3_CHB
	LD	HL, (PT3_AY_REGS + PT3AY_TONB)
	CALL	PT3_CHANNEL_TO_SHADOW_B
	LD	IX, PT3_CHC
	LD	HL, (PT3_AY_REGS + PT3AY_TONC)
	CALL	PT3_CHANNEL_TO_SHADOW_C
	LD	A, (PT3_NS_BASE)
	LD	HL, PT3_ADDTONS
	LD	E, (HL)
	LD	D, A
	LD	A, D
	ADD	A, E
	LD	(PT3_AY_REGS + 6), A
	LD	HL, PT3_AY_REGS
	CALL	PSG_ROUT_BLOCK
	POP	HL
	POP	DE
	POP	BC
	RET

; One pattern line per channel per quark (channel A: position advance when stream at 0).
PT3_PLAY_TICK:
	LD	HL, PT3_CHA + PT3C_NTSKCN
	DEC	(HL)
	JR	NZ, PT3_TICK_B
	LD	BC, (PT3_ADR_A)
	LD	A, (BC)
	OR	A
	JR	NZ, PT3_TICK_A_DECODE
	CALL	PT3_ADVANCE_POSITION
	LD	A, (PLAY_STATE)
	CP	PLAY_STOPPED
	JP	Z, PT3_PLAY_TICK_DONE
PT3_TICK_A_DECODE:
	LD	IX, PT3_CHA
	LD	BC, (PT3_ADR_A)
	CALL	PT3_DECODE_CH
	LD	(PT3_ADR_A), BC
PT3_TICK_B:
	LD	HL, PT3_CHB + PT3C_NTSKCN
	DEC	(HL)
	JR	NZ, PT3_TICK_C
	LD	IX, PT3_CHB
	LD	BC, (PT3_ADR_B)
	CALL	PT3_DECODE_CH
	LD	(PT3_ADR_B), BC
PT3_TICK_C:
	LD	HL, PT3_CHC + PT3C_NTSKCN
	DEC	(HL)
	JR	NZ, PT3_PLAY_TICK_DONE
	LD	IX, PT3_CHC
	LD	BC, (PT3_ADR_C)
	CALL	PT3_DECODE_CH
	LD	(PT3_ADR_C), BC
PT3_PLAY_TICK_DONE:
	RET

; One-line trace when DEBUG_FLAG set (see vibetune.asm). Called after each row tick.
PT3_DEBUG_ROW:
	LD	A, (DEBUG_FLAG)
	OR	A
	RET	Z
	LD	HL, (PT3_POS_PTR)
	LD	A, (HL)
	PUSH	AF
	LD	DE, MSG_DBG_PREFIX
	CALL	PRTSTR
	POP	AF
	CALL	PRINT_HEX_BYTE
	LD	DE, MSG_DBG_A
	CALL	PRTSTR
	LD	HL, (PT3_ADR_A)
	LD	A, L
	CALL	PRINT_HEX_BYTE
	LD	DE, MSG_DBG_B
	CALL	PRTSTR
	LD	HL, (PT3_ADR_B)
	LD	A, L
	CALL	PRINT_HEX_BYTE
	LD	DE, MSG_DBG_C
	CALL	PRTSTR
	LD	HL, (PT3_ADR_C)
	LD	A, L
	CALL	PRINT_HEX_BYTE
	LD	DE, MSG_DBG_N
	CALL	PRTSTR
	LD	IX, PT3_CHA
	LD	A, (IX + PT3C_NOTE)
	CALL	PRINT_HEX_BYTE
	LD	DE, MSG_DBG_F
	CALL	PRTSTR
	LD	A, (IX + PT3C_FLAGS)
	CALL	PRINT_HEX_BYTE
	LD	DE, MSG_DBG_S
	CALL	PRTSTR
	LD	A, (PLAY_STATE)
	CALL	PRINT_HEX_BYTE
	CALL	CRLF
	RET

PT3_ENGINE_INIT:
	LD	HL, MUSIC_BUF
	LD	(PT3_MDL_PTR), HL
	LD	BC, PT3_PATTAB_OFF
	ADD	HL, BC
	LD	C, (HL)
	INC	HL
	LD	B, (HL)
	LD	HL, MUSIC_BUF
	ADD	HL, BC
	LD	(PT3_PATS_PTR), HL
	LD	HL, MUSIC_BUF
	LD	DE, PT3_POS_OFF
	ADD	HL, DE
	LD	(PT3_POS_PTR), HL
	LD	HL, MUSIC_BUF
	LD	DE, PT3_SPEED_OFF
	ADD	HL, DE
	LD	A, (HL)
	LD	(PT3_DELAY), A
	OR	A
	JR	NZ, PT3_INIT_DLY
	LD	A, 6
	LD	(PT3_DELAY), A
PT3_INIT_DLY:
	LD	A, 1
	LD	(PT3_QUARK_CNT), A
	; Bulba note table from header byte 99
	LD	HL, MUSIC_BUF
	LD	DE, 99
	ADD	HL, DE
	LD	A, (HL)
	RLA
	AND	7
	CALL	PT3_SELECT_NOTE_TABLE
	CALL	PT3_INIT_VOL_TABLE
	LD	HL, PT3_CHA
	LD	B, PT3_CH_SIZE
	CALL	PT3_MEM_CLR
	LD	HL, PT3_CHB
	LD	B, PT3_CH_SIZE
	CALL	PT3_MEM_CLR
	LD	HL, PT3_CHC
	LD	B, PT3_CH_SIZE
	CALL	PT3_MEM_CLR
	LD	HL, PT3_AY_REGS
	LD	B, 14
	CALL	PT3_MEM_CLR
	LD	A, $FF
	LD	(PT3_AY_REGS + PT3AY_TONA), A
	LD	(PT3_AY_REGS + PT3AY_TONA + 1), A
	LD	(PT3_AY_REGS + PT3AY_TONB), A
	LD	(PT3_AY_REGS + PT3AY_TONB + 1), A
	LD	(PT3_AY_REGS + PT3AY_TONC), A
	LD	(PT3_AY_REGS + PT3AY_TONC + 1), A
	LD	A, 1
	LD	(PT3_CHA + PT3C_NNTSKP), A
	LD	(PT3_CHB + PT3C_NNTSKP), A
	LD	(PT3_CHC + PT3C_NNTSKP), A
	LD	A, $0F
	LD	(PT3_CHA + PT3C_VOLUME), A
	LD	(PT3_CHB + PT3C_VOLUME), A
	LD	(PT3_CHC + PT3C_VOLUME), A
	LD	A, 1
	LD	(PT3_CHA + PT3C_NTSKCN), A
	LD	(PT3_CHB + PT3C_NTSKCN), A
	LD	(PT3_CHC + PT3C_NTSKCN), A
	LD	A, $3F
	LD	(PT3_AY_REGS + PT3AY_MIXER), A
	LD	A, $FF
	LD	(PT3_AY_REGS + PT3AY_TONA), A
	LD	(PT3_AY_REGS + PT3AY_TONA + 1), A
	LD	(PT3_AY_REGS + PT3AY_TONB), A
	LD	(PT3_AY_REGS + PT3AY_TONB + 1), A
	LD	(PT3_AY_REGS + PT3AY_TONC), A
	LD	(PT3_AY_REGS + PT3AY_TONC + 1), A
	LD	A, $0F
	LD	(PT3_AY_REGS + PT3AY_AMPA), A
	LD	(PT3_AY_REGS + PT3AY_AMPB), A
	LD	(PT3_AY_REGS + PT3AY_AMPC), A
	LD	A, $80
	LD	(PT3_AY_REGS + PT3AY_ENVTP), A
	LD	HL, (PT3_MDL_PTR)
	LD	DE, PT3_OFF_ORN_TAB
	ADD	HL, DE
	LD	(PT3_ORN_PTRS), HL
	LD	HL, (PT3_MDL_PTR)
	LD	DE, PT3_OFF_SAM_TAB
	ADD	HL, DE
	LD	(PT3_SAM_PTRS), HL
	LD	IX, PT3_CHA
	XOR	A
	CALL	PT3_SETORN
	LD	IX, PT3_CHB
	XOR	A
	CALL	PT3_SETORN
	LD	IX, PT3_CHC
	XOR	A
	CALL	PT3_SETORN
	LD	IX, PT3_CHA
	XOR	A
	CALL	PT3_SETSAM
	LD	IX, PT3_CHB
	XOR	A
	CALL	PT3_SETSAM
	LD	IX, PT3_CHC
	XOR	A
	CALL	PT3_SETSAM
	CALL	PT3_BIND_PATTERN
	JR	NC, PT3_INIT_OK
	LD	A, ERR_INVALID_DATA
	RET
PT3_INIT_OK:
	XOR	A
	RET

PT3_ENGINE_STEP:
	LD	HL, PT3_QUARK_CNT
	DEC	(HL)
	JR	NZ, PT3_STEP_OUTPUT
	LD	A, (PT3_DELAY)
	OR	A
	JR	NZ, PT3_STEP_RELOAD
	LD	A, 6
PT3_STEP_RELOAD:
	LD	(PT3_QUARK_CNT), A
	CALL	PT3_PLAY_TICK
	CALL	PT3_DEBUG_ROW
PT3_STEP_OUTPUT:
	LD	A, (PLAY_STATE)
	CP	PLAY_STOPPED
	RET	Z
	JP	PT3_FLUSH_AY

PT3_ENGINE_QUARK:
	CALL	PT3_PLAY_TICK
	LD	A, (PLAY_STATE)
	CP	PLAY_STOPPED
	RET	Z
	JP	PT3_FLUSH_AY
