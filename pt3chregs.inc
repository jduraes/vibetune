; PT3 CHREGS — Bulba-equivalent (tune.asm CHREGS, PT3-only, clean-room).

#DEFINE PT3C_CRAMSL     2
#DEFINE PT3C_CRNSSL     3
#DEFINE PT3C_CRENSL     4
#DEFINE PT3C_TSLCNT     5
#DEFINE PT3C_CONOFF     10
#DEFINE PT3C_ONOFFD     11
#DEFINE PT3C_OFFOND     12
#DEFINE PT3C_SLTONT     19
#DEFINE PT3C_TNSLDL     22
#DEFINE PT3C_TSLSTP     23
#DEFINE PT3C_TNDELT     25

; IX = channel; HL = prior tone. Returns HL = period; PT3_AMPL (0 = loudest).
PT3_CHREGS:
	XOR	A
	LD	(PT3_AMPL), A
	BIT	0, (IX + PT3C_FLAGS)
	PUSH	HL
	JP	Z, PT3_CH_EXIT_INACT
	; Ornament: header (B=restart, C=end), delta at ornptr+2+PsInOr
	LD	L, (IX + PT3C_ORNPTR)
	LD	H, (IX + PT3C_ORNPTR + 1)
	LD	B, (HL)
	INC	HL
	LD	C, (HL)
	INC	HL
	LD	A, (IX + PT3C_PSINOR)
	LD	E, A
	LD	D, 0
	ADD	HL, DE
	LD	E, (HL)
	LD	A, (IX + PT3C_PSINOR)
	INC	A
	CP	C
	JR	C, PT3_CH_ORNOK
	LD	A, B
PT3_CH_ORNOK:
	LD	(IX + PT3C_PSINOR), A
	LD	A, (IX + PT3C_NOTE)
	ADD	A, E
	JP	P, PT3_CH_NTP
	XOR	A
PT3_CH_NTP:
	CP	96
	JR	C, PT3_CH_NOK
	LD	A, 95
PT3_CH_NOK:
	PUSH	AF
	; Sample: header (E=restart, D=end); line = C,B,L,H at samptr+2+4*PsInSm
	LD	L, (IX + PT3C_SAMPTR)
	LD	H, (IX + PT3C_SAMPTR + 1)
	LD	E, (HL)
	INC	HL
	LD	D, (HL)
	INC	HL
	PUSH	DE
	LD	A, (IX + PT3C_PSINSM)
	ADD	A, A
	ADD	A, A
	LD	E, A
	LD	D, 0
	ADD	HL, DE
	LD	C, (HL)
	INC	HL
	LD	B, (HL)
	INC	HL
	LD	L, (HL)
	INC	HL
	LD	H, (HL)
	LD	A, (IX + PT3C_PSINSM)
	INC	A
	POP	DE
	CP	D
	JR	C, PT3_CH_SMOK
	LD	A, E
PT3_CH_SMOK:
	LD	(IX + PT3C_PSINSM), A
	LD	E, (IX + PT3C_TNACC)
	LD	D, (IX + PT3C_TNACC + 1)
	ADD	HL, DE
	BIT	6, B
	JR	Z, PT3_CH_NOAC
	LD	(IX + PT3C_TNACC), L
	LD	(IX + PT3C_TNACC + 1), H
PT3_CH_NOAC:
	EX	DE, HL
	POP	AF
	DEC	A
	LD	L, A
	LD	H, 0
	ADD	HL, HL
	LD	DE, PT3_NT_
	ADD	HL, DE
	LD	E, (HL)
	INC	HL
	LD	D, (HL)
	LD	L, (IX + PT3C_CRTNSL)
	LD	H, (IX + PT3C_CRTNSL + 1)
	ADD	HL, DE
	LD	D, H
	LD	E, L
	XOR	A
	OR	(IX + PT3C_TSLCNT)
	JR	Z, PT3_CH_AMP
	DEC	(IX + PT3C_TSLCNT)
	JR	NZ, PT3_CH_AMP
	LD	A, (IX + PT3C_TNSLDL)
	LD	(IX + PT3C_TSLCNT), A
	LD	L, (IX + PT3C_TSLSTP)
	LD	H, (IX + PT3C_TSLSTP + 1)
	LD	A, H
	ADD	HL, DE
	LD	(IX + PT3C_CRTNSL), L
	LD	(IX + PT3C_CRTNSL + 1), H
	BIT	2, (IX + PT3C_FLAGS)
	JR	NZ, PT3_CH_AMP
	LD	E, (IX + PT3C_TNDELT)
	LD	D, (IX + PT3C_TNDELT + 1)
	AND	A
	JR	Z, PT3_CH_STPP
	EX	DE, HL
PT3_CH_STPP:
	SBC	HL, DE
	JP	M, PT3_CH_AMP
	LD	A, (IX + PT3C_SLTONT)
	LD	(IX + PT3C_NOTE), A
	XOR	A
	LD	(IX + PT3C_TSLCNT), A
	LD	(IX + PT3C_CRTNSL), A
	LD	(IX + PT3C_CRTNSL + 1), A
PT3_CH_AMP:
	LD	A, (IX + PT3C_CRAMSL)
	BIT	7, C
	JR	Z, PT3_CH_NOAM
	BIT	6, C
	JR	Z, PT3_CH_AMIN
	CP	15
	JR	Z, PT3_CH_NOAM
	INC	A
	JR	PT3_CH_SVAM
PT3_CH_AMIN:
	CP	$F1
	JR	Z, PT3_CH_NOAM
	DEC	A
PT3_CH_SVAM:
	LD	(IX + PT3C_CRAMSL), A
PT3_CH_NOAM:
	LD	L, A
	LD	A, B
	AND	$0F
	ADD	A, L
	JP	P, PT3_CH_APOS
	XOR	A
PT3_CH_APOS:
	CP	16
	JR	C, PT3_CH_VOL
	LD	A, 15
PT3_CH_VOL:
	OR	(IX + PT3C_VOLUME)
	ADD	A, PT3_VT_ & $FF
	LD	L, A
	ADC	A, PT3_VT_ / 256
	SUB	L
	LD	H, A
	LD	A, (HL)
	BIT	0, C
	JR	NZ, PT3_CH_NOEN
	OR	(IX + PT3C_ENV_EN)
PT3_CH_NOEN:
	LD	(PT3_AMPL), A
	BIT	7, B
	LD	A, B
	JR	Z, PT3_CH_NOENSL
	RLA
	RLA
	SRA	A
	SRA	A
	SRA	A
	ADD	A, (IX + PT3C_CRENSL)
	BIT	5, B
	JR	Z, PT3_CH_NOENAC
	LD	(IX + PT3C_CRENSL), A
PT3_CH_NOENAC:
	LD	HL, PT3_ADDTOEN
	ADD	A, (HL)
	LD	(HL), A
	JR	PT3_CH_MIX
PT3_CH_NOENSL:
	RRA
	ADD	A, (IX + PT3C_CRNSSL)
	LD	(PT3_ADDTONS), A
	BIT	5, B
	JR	Z, PT3_CH_MIX
	LD	(IX + PT3C_CRNSSL), A
PT3_CH_MIX:
	LD	A, B
	RRA
	AND	$48
PT3_CH_EXIT:
	LD	HL, PT3_AY_REGS + PT3AY_MIXER
	OR	(HL)
	RRCA
	LD	(HL), A
	POP	HL
	EX	DE, HL
PT3_CH_EXIT_INACT:
	POP	HL
PT3_CH_EXIT2:
	XOR	A
	OR	(IX + PT3C_CONOFF)
	RET	Z
	DEC	(IX + PT3C_CONOFF)
	RET	NZ
	XOR	(IX + PT3C_FLAGS)
	LD	(IX + PT3C_FLAGS), A
	RRA
	LD	A, (IX + PT3C_ONOFFD)
	JR	C, PT3_CH_ONDL
	LD	A, (IX + PT3C_OFFOND)
PT3_CH_ONDL:
	LD	(IX + PT3C_CONOFF), A
	RET
