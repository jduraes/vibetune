;
; Quark timing
; WAITQ uses HBIOS timer when available, else CPU-calibrated delay loop (40 T-states/iter).
;

PROBETIMER:
	LD	A, (DELAYMD)
	OR	A
	JR	Z, PROBETIMER_PROBE
	XOR	A
	LD	(WMOD), A
	RET
PROBETIMER_PROBE:
	XOR	A
	LD	(WMOD), A
	LD	B, BF_SYSGET
	LD	C, $D0
	RST	08
	LD	A, L
	OR	H
	OR	E
	OR	D
	RET	Z
	LD	A, $FF
	LD	(WMOD), A
	RET

INIT_QDLY_BASE:
	LD	B, BF_SYSGET
	LD	C, $F0
	RST	08
	LD	(CPUKHZ), DE
	SRL	D
	RR	E
	EX	DE, HL
	LD	(QDLY0), HL
	LD	(QDLY), HL
	RET

APPLY_ENGINE_QDLY_ADJ:
	LD	HL, (APPLY_COUNT)
	INC	HL
	LD	(APPLY_COUNT), HL
	LD	HL, (QDLY0)
	LD	DE, 185
	LD	A, (FILE_ENGINE)
	CP	ENGINE_MYM
	JR	NZ, APPLY_QDLY_SUB
	LD	DE, 125
APPLY_QDLY_SUB:
	OR	A
	SBC	HL, DE
	JR	NC, APPLY_QDLY_DBG1
	XOR	A
	LD	H, A
	LD	L, A
APPLY_QDLY_DBG1:
	LD	(QDLY_DBG1), HL
	LD	A, (FILE_ENGINE)
	CP	ENGINE_PTX
	JR	NZ, APPLY_QDLY_STORE
	LD	A, (TSFLAG)
	OR	A
	JR	Z, APPLY_QDLY_STORE
	LD	A, (TS_DUALHW)
	OR	A
	JR	Z, APPLY_QDLY_STORE
	LD	A, (WMOD)
	OR	A
	JR	NZ, APPLY_QDLY_STORE
	LD	(QDLY), HL
	CALL	TS_ADJTIM
	; RC2014 rl2wofts cal (delay, TS dual): trim->BPM empirical, non-linear.
	; 856->90, 1084->97; bracket 94 => trim 856+(94-90)*(228/7) ~ 986.
	LD	HL, (QDLY)
	LD	DE, 986
	OR	A
	SBC	HL, DE
	JR	NC, APPLY_QDLY_TS_TRIM_OK
	XOR	A
	LD	H, A
	LD	L, A
APPLY_QDLY_TS_TRIM_OK:
	LD	(QDLY), HL
APPLY_QDLY_STORE:
	LD	(QDLY), HL
	RET

; QDLY := QDLY * 97 / 128 (tune.com TS_ADJTIM).
TS_ADJTIM:
	LD	HL, (QDLY)
	LD	B, H
	LD	C, L
	LD	H, B
	LD	L, C
	SRL	H
	RR	L
	SRL	H
	RR	L
	EX	DE, HL
	LD	H, B
	LD	L, C
	OR	A
	SBC	HL, DE
	PUSH	HL
	LD	H, B
	LD	L, C
	LD	A, 7
TS_ADJ2:
	SRL	H
	RR	L
	DEC	A
	JR	NZ, TS_ADJ2
	POP	DE
	ADD	HL, DE
	LD	(QDLY), HL
	RET

PRINT_TIMING_DEBUG:
	CALL	CRLF
	LD	DE, MSG_DBG_CPU
	CALL	PRTSTR
	LD	HL, (CPUKHZ)
	CALL	PRINT_DEC_WORD
	CALL	CRLF
	LD	DE, MSG_DBG_QDLY0
	CALL	PRTSTR
	LD	HL, (QDLY0)
	CALL	PRINT_DEC_WORD
	LD	DE, MSG_DBG_SUB1
	CALL	PRTSTR
	LD	HL, (QDLY_DBG1)
	CALL	PRINT_DEC_WORD
	LD	DE, MSG_DBG_QDLY
	CALL	PRTSTR
	LD	HL, (QDLY)
	CALL	PRINT_DEC_WORD
	LD	DE, MSG_DBG_APPLY
	CALL	PRTSTR
	LD	HL, (APPLY_COUNT)
	CALL	PRINT_DEC_WORD
	LD	DE, MSG_DBG_FLAGS
	CALL	PRTSTR
	LD	A, (FILE_ENGINE)
	CALL	PRINT_DEC_BYTE
	LD	A, (TSFLAG)
	CALL	PRINT_DEC_BYTE
	LD	A, (TS_DUALHW)
	CALL	PRINT_DEC_BYTE
	LD	A, (WMOD)
	CALL	PRINT_DEC_BYTE
	JP	CRLF

PRINT_TIMING_MODE:
	LD	A, (WMOD)
	OR	A
	LD	DE, MSG_TIMING_DLY
	JR	Z, PRINT_TIMING_MODE_OUT
	LD	DE, MSG_TIMING_TIM
PRINT_TIMING_MODE_OUT:
	JP	PRTSTR

WAITQ:
	LD	A, (WMOD)
	OR	A
	JR	Z, WAITQ_DLY
WAITQ_TIM:
	CALL	WAITQ_TIM2
	LD	C, A
WAITQ_TIM1:
	PUSH	BC
	CALL	WAITQ_TIM2
	POP	BC
	CP	C
	RET	NZ
	JR	WAITQ_TIM1

WAITQ_TIM2:
	LD	B, BF_SYSGET
	LD	C, $D0
	RST	08
	LD	A, L
	RET

WAITQ_DLY:
	LD	BC, (QDLY)
	LD	A, B
	OR	C
	JR	NZ, WAITQ_DLY1
	LD	BC, 1			; QDLY==0: avoid DEC wrap to 65535
WAITQ_DLY1:
	DEC	BC
	NOP
	NOP
	NOP
	NOP
	LD	A, B
	OR	C
	JP	NZ, WAITQ_DLY1
	RET
